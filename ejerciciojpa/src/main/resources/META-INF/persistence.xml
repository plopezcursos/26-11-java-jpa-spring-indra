<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="3.0"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
	
	<persistence-unit name="jpa_pu" transaction-type="RESOURCE_LOCAL">

		<class>es.cursogetafe.ejerciciojpa.modelo.Categoria</class>
		<class>es.cursogetafe.ejerciciojpa.modelo.Cliente</class>
		<class>es.cursogetafe.ejerciciojpa.modelo.Colaborador</class>
		<class>es.cursogetafe.ejerciciojpa.modelo.Empleado</class>
		<class>es.cursogetafe.ejerciciojpa.modelo.Persona</class>
		<class>es.cursogetafe.ejerciciojpa.modelo.Producto</class>
		
		<properties>
			<property name="hibernate.show_sql" value="true" />
			<property name="hibernate.format_sql" value="true" />
			<property name="hibernate.highlight_sql" value="true" />
			<property name="hibernate.use_sql_comments" value="false" />

			<property name="jakarta.persistence.jdbc.url" value="jdbc:h2:file:./datos/ejercicio_jpa;DB_CLOSE_DELAY=-1" />
			<property name="jakarta.persistence.jdbc.user" value="sa" />
		</properties>
	</persistence-unit>

</persistence>
